# Hyperf API — produção (VPS + docker-compose.prod.yml)
# cp .env.production.example .env.production
# Preencha TODOS os placeholders antes de subir. Nunca committe este ficheiro.
#
# Uso:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

APP_NAME="VictorDev"
APP_ENV=prod
APP_URL=https://api.seudominio.com
APP_DEBUG=false

# Swagger — desligado em produção
SWAGGER_ENABLE=false
SWAGGER_PORT=9500
SWAGGER_AUTO_GENERATE=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

APP_USER_REPOSITORY=db

# Gere um secret longo (ex.: openssl rand -hex 32)
APP_AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX_SECRET
APP_AUTH_TOKEN_TTL=604800
APP_AUTH_RESET_STORE=redis
APP_AUTH_RESET_TOKEN_TTL=3600
APP_LOG_PASSWORD_RESET_TOKEN=false
# Link no e-mail de reset (front-end). Use {token} e {email}
APP_PASSWORD_RESET_URL=https://app.seudominio.com/reset-password?token={token}&email={email}

# PostgreSQL (serviço "postgres" no compose — não expor ao host)
DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=victordev
DB_USERNAME=victordev
# openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_PREFIX=

# Redis (serviço "redis" no compose — rede interna)
REDIS_HOST=redis
REDIS_AUTH=null
REDIS_PORT=6379
REDIS_DB=0

# SMTP real (sem Mailpit)
MAIL_ENABLED=true
# Preferível: smtp://user:pass@smtp.example.com:587 (escape caracteres especiais na password)
MAILER_DSN=
MAIL_HOST=smtp.seudominio.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@seudominio.com
MAIL_FROM_NAME="VictorDev"
MAIL_RESET_SUBJECT="Redefinição de senha de VictorDev"
MAIL_CONTACT_SUBJECT="Nova mensagem de contacto"
MAIL_CONTACT_TO=admin@seudominio.com

# Cloudflare Turnstile (recomendado em produção)
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CORS — origins do frontend (vírgulas). Preflight OPTIONS → 204.
CORS_ORIGINS=https://victorsf.com,https://www.victorsf.com,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false

# Rate limit do formulário de contacto (por IP)
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=300

# Object storage — Cloudflare R2
# R2_ENDPOINT = S3 API only (sem /bucket no path). Bucket e prefix vão em R2_BUCKET / FILESYSTEM_PREFIX.
# R2_PUBLIC_URL = domínio público (r2.dev ou CDN). NÃO uses o endpoint S3 — não serve browser.
FILESYSTEM_DRIVER=r2
FILESYSTEM_PREFIX=production
FILESYSTEM_PUBLIC_URL=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=victorsf
R2_ENDPOINT=https://b702d6c53f8aed6df35d42c2db93fb89.r2.cloudflarestorage.com
R2_REGION=auto
R2_USE_PATH_STYLE=true
R2_PUBLIC_URL=https://cdn.victorsf.com

# Readiness falha se R2 estiver indisponível
APP_STORAGE_HEALTH_REQUIRED=true

UPLOAD_QUEUE_PROCESSING=true
UPLOAD_IMAGE_MAX_WIDTH=2048
UPLOAD_IMAGE_MAX_HEIGHT=2048
UPLOAD_JPEG_QUALITY=85
UPLOAD_WEBP_QUALITY=82
UPLOAD_THUMB_WIDTH=400
UPLOAD_THUMB_HEIGHT=400

# Domínio público servido pelo Nginx (server_name)
NGINX_SERVER_NAME=api.seudominio.com

SCAN_CACHEABLE=true

# Portas publicadas no host (Nginx). Se 80/443 já estiverem ocupadas, altera (ex.: 8080/8443).
HTTP_PUBLISH_PORT=8080
HTTPS_PUBLISH_PORT=443
