# Hyperf API — VictorDev
# Setup: cp .env.example .env && chmod +x hyper && ./hyper install

APP_NAME="VictorDev"
APP_ENV=dev
# Base URL for canonical links in page SEO (production: https://yourdomain.com)
APP_URL=http://127.0.0.1:9501
# true = erros 500 em JSON com exception, file, line e trace (desligue em produção)
APP_DEBUG=true

# Idioma: pt_BR (padrão) ou en — ficheiros em storage/languages/{locale}/
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# DDD / Hexagonal: memory (padrão) ou db (requer migrate — recomendado com Docker)
# Com db, após hyper migrate: admin@victordev.com e manager@victordev.com — senha VictorDev123! (dev apenas)
APP_USER_REPOSITORY=db

# Auth: Bearer token assinado (HMAC). Troque APP_AUTH_SECRET em produção.
APP_AUTH_SECRET=change-me-to-a-long-random-string
APP_AUTH_TOKEN_TTL=604800
# Reset de senha: array (dev/teste) ou redis (produção / multi-worker)
APP_AUTH_RESET_STORE=array
APP_AUTH_RESET_TOKEN_TTL=3600
# true = loga o token de reset no stdout (apenas debug)
APP_LOG_PASSWORD_RESET_TOKEN=false
# Opcional: link no e-mail (ex.: front-end). Use {token} e {email}
APP_PASSWORD_RESET_URL=

DB_DRIVER=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE="victordev"
DB_USERNAME=postgres
# Deve coincidir com POSTGRES_PASSWORD no docker-compose (padrão: postgres)
DB_PASSWORD=postgres
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer
DB_PREFIX=

# pgAdmin — UI http://localhost:5050 (servidor "Hyperf (Docker)" pré-configurado)
PGADMIN_DEFAULT_EMAIL=admin@victordev.com
PGADMIN_DEFAULT_PASSWORD=admin

REDIS_HOST=redis
REDIS_AUTH=null
# Porta na rede Docker (serviço redis:6379). NÃO use REDIS_PUBLISH_PORT aqui.
REDIS_PORT=6379
REDIS_DB=0

# Portas publicadas no host (docker compose / hyper) — opcional; omissão = valores abaixo
# API_PORT=9501
# REDIS_PUBLISH_PORT=6379
# DB_PUBLISH_PORT=5432
# PGADMIN_PUBLISH_PORT=5050
# MAIL_WEB_PORT=8025
# MAIL_SMTP_PORT=1025

# Mailpit: UI http://localhost:8025 | SMTP 1025 (no Docker use host "mailpit")
MAIL_ENABLED=true
# Se vazio, usa MAIL_HOST + MAIL_PORT (sem TLS, típico Mailpit)
MAILER_DSN=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@victordev.com.br
MAIL_FROM_NAME="VictorDev"
MAIL_RESET_SUBJECT="Redefinição de senha de VictorDev"
MAIL_CONTACT_SUBJECT="Nova mensagem de contacto"
MAIL_CONTACT_TO=admin@victordev.com

# Cloudflare Turnstile (opcional — anti-spam no formulário de contacto)
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Object storage — minio (dev/testes Docker) | r2 (Cloudflare produção)
FILESYSTEM_DRIVER=minio
# Pasta dentro do bucket victorsf: development (dev) | production (R2 prod)
FILESYSTEM_PREFIX=development
# URL pública opcional (ex.: domínio customizado R2 ou MinIO exposto)
FILESYSTEM_PUBLIC_URL=

# Cloudflare R2 (S3-compatible) — produção/staging
# Endpoint: https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=victorsf
R2_ENDPOINT=https://b702d6c53f8aed6df35d42c2db93fb89.r2.cloudflarestorage.com
R2_REGION=auto
R2_PUBLIC_URL=

# MinIO (dev / testes) — serviço minio no docker-compose
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_BUCKET=victorsf
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://127.0.0.1:9000/victorsf
# MINIO_PUBLISH_PORT=9000
# MINIO_CONSOLE_PUBLISH_PORT=9001

# true = falha de readiness se storage (minio/r2) estiver indisponível
APP_STORAGE_HEALTH_REQUIRED=false

# Upload: fila Redis processa optimize → WebP → thumbnail (requer ext-gd no container)
UPLOAD_QUEUE_PROCESSING=true
UPLOAD_IMAGE_MAX_WIDTH=2048
UPLOAD_IMAGE_MAX_HEIGHT=2048
UPLOAD_JPEG_QUALITY=85
UPLOAD_WEBP_QUALITY=82
UPLOAD_THUMB_WIDTH=400
UPLOAD_THUMB_HEIGHT=400

UID=1000
GID=1000
