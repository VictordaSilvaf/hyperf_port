APP_NAME="VictorDev"
APP_ENV=dev
# true = erros 500 em JSON com exception, file, line e trace (desligue em produção)
APP_DEBUG=true

# Idioma: pt_BR (padrão) ou en — ficheiros em storage/languages/{locale}/
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# DDD / Hexagonal: memory (padrão) ou db (requer migrate e tabela users)
# Com db, após migrate: admin@victordev.com e manager@victordev.com — senha VictorDev123! (dev apenas)
APP_USER_REPOSITORY=memory

# Auth: Bearer token assinado (HMAC). Troque APP_AUTH_SECRET em produção.
APP_AUTH_SECRET=change-me-to-a-long-random-string
APP_AUTH_TOKEN_TTL=604800
# Reset de senha: array (dev/teste) ou redis (produção / multi-worker)
APP_AUTH_RESET_STORE=array
APP_AUTH_RESET_TOKEN_TTL=3600
# true = loga o token de reset no stdout (apenas debug)
APP_LOG_PASSWORD_RESET_TOKEN=false
# Opcional: link no e-mail (ex.: front-end). Use {token} e {email}
APP_PASSWORD_RESET_URL=

DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE="victordev"
DB_USERNAME=root
# Deve ser igual a MYSQL_ROOT_PASSWORD no docker-compose (padrão: root)
DB_PASSWORD=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=

REDIS_HOST=redis
REDIS_AUTH=null
REDIS_PORT=6379
REDIS_DB=0

# Mailpit: UI http://localhost:8025 | SMTP 1025 (no Docker use host "mailpit")
MAIL_ENABLED=true
# Se vazio, usa MAIL_HOST + MAIL_PORT (sem TLS, típico Mailpit)
MAILER_DSN=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@victordev.com.br
MAIL_FROM_NAME="VictorDev"
MAIL_RESET_SUBJECT="Redefinição de senha de VictorDev"

UID=1003
GID=1003
